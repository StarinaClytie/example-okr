{
  "name": "example-okr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "node scripts/build-production.mjs",
    "verify:config": "node scripts/verify-supabase-config.mjs",
    "test:smoke:real": "vitest run src/pages/pageFrameworks.test.tsx src/dashboard/DashboardPage.test.tsx src/app/routes.test.tsx src/i18n/LocaleProvider.test.tsx",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "server:dev": "tsx server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist-server/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@supabase/supabase-js": "^2.112.3",
    "ali-oss": "^6.23.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "~8.7.3",
    "lucide-react": "~1.31.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-router-dom": "~7.18.2",
    "recharts": "~3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.3",
    "@types/ali-oss": "^6.23.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "~6.0.5",
    "jsdom": "29.1.1",
    "supabase": "2.121.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "~8.3.6",
    "vitest": "~4.1.12"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
