# Edge Function secrets only. Never place these in browser/VITE_ variables.
# Copy to .env.functions.local (gitignored), fill values, then upload with:
# npm exec supabase -- secrets set --env-file .env.functions.local --project-ref YOUR_PROJECT_REF
RESEND_API_KEY=
# Use an address on your Resend-verified domain; set explicitly.
RESEND_FROM_EMAIL=
# Required for an independent installation: your HTTPS app origin, no trailing slash.
# Missing sender or app URL disables delivery with email_not_configured.
RESOURCE_APP_URL=
# Hosted Supabase injects SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
