# Server-only attachment API configuration. Never prefix secrets with VITE_.
# Copy to .env.server.local (gitignored), fill values, then start with:
# ATTACHMENT_ENV_FILE=.env.server.local npm run server:start
ATTACHMENT_API_HOST=127.0.0.1
ATTACHMENT_API_PORT=3001
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
# Per-process fixed-window request budgets. Positive integers; zero is invalid.
# Admission is shared across both attachment APIs before token verification.
# User requests are keyed by verified account ID (not IP or bearer token).
ATTACHMENT_RATE_LIMIT_WINDOW_MS=60000
ATTACHMENT_RATE_LIMIT_GLOBAL_REQUESTS=6000
ATTACHMENT_RATE_LIMIT_USER_REQUESTS=120
