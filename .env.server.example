# Server-only attachment API configuration. Never prefix secrets with VITE_.
# Copy to .env.server.local (gitignored), fill values, then start with:
# ATTACHMENT_ENV_FILE=.env.server.local npm run server:start
ATTACHMENT_API_HOST=127.0.0.1
ATTACHMENT_API_PORT=3001
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# One provider per deployment: oss (default), s3, or r2.
# Choose before the first upload; changing these does not migrate existing files.
ATTACHMENT_STORAGE_PROVIDER=oss
# OSS only: existing variable names remain supported.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
# S3 and R2 only: fill these when selecting s3 or r2 above.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional temporary-credential token:
S3_SESSION_TOKEN=
S3_BUCKET=
# Required for s3; r2 defaults to auto and accepts only auto.
S3_REGION=
# Optional HTTPS endpoint for s3; required official account HTTPS endpoint for r2.
# R2: https://<32-hex-account-id>.r2.cloudflarestorage.com
# Optional jurisdiction: <32-hex-account-id>.eu.r2.cloudflarestorage.com
# or <32-hex-account-id>.us.r2.cloudflarestorage.com
# or <32-hex-account-id>.fedramp.r2.cloudflarestorage.com
S3_ENDPOINT=
# Optional strict true/false; omit to use false for s3, true for r2.
# S3_FORCE_PATH_STYLE=false
# See docs/object-storage.md for private buckets, permissions and CORS.
# Per-process fixed-window request budgets. Positive integers; zero is invalid.
# Admission is shared across both attachment APIs before token verification.
# User requests are keyed by verified account ID (not IP or bearer token).
ATTACHMENT_RATE_LIMIT_WINDOW_MS=60000
ATTACHMENT_RATE_LIMIT_GLOBAL_REQUESTS=6000
ATTACHMENT_RATE_LIMIT_USER_REQUESTS=120
