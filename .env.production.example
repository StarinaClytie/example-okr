# Browser-only production build configuration for your independent installation.
# Copy to .env.production.local (gitignored) and replace both placeholders.
# Configure SMTP in Auth settings and server/OSS secrets separately.
# Never put service-role keys, database passwords or OSS credentials here.
VITE_APP_MODE=supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
